local DEFAULT_SCAN_INTERVAL = 15
local AutoScan = false
local ScanInterval = DEFAULT_SCAN_INTERVAL
local LastScanResults = {}
local MAX_FIELDS_PER_EMBED = 25
local MAX_LIST_ITEMS = 200

-- ---------- HTTP fallback ----------
local function sendWebhookPayload(payloadJson)
    local funcs = {
        function() if syn and syn.request then return syn.request({Url=WEBHOOK_URL, Method="POST", Headers={["Content-Type"]="application/json"}, Body=payloadJson}) end end,
        function() if request then return request({Url=WEBHOOK_URL, Method="POST", Headers={["Content-Type"]="application/json"}, Body=payloadJson}) end end,
        function() if http_request then return http_request({Url=WEBHOOK_URL, Method="POST", Headers={["Content-Type"]="application/json"}, Body=payloadJson}) end end,
        function() if http and http.request then return http.request({Url=WEBHOOK_URL, Method="POST", Headers={["Content-Type"]="application/json"}, Body=payloadJson}) end end,
        function() return HttpService:PostAsync(WEBHOOK_URL, payloadJson, Enum.HttpContentType.ApplicationJson) end
    }
    for _, f in ipairs(funcs) do
        local ok, res = pcall(f)
        if ok and res then return true end
    end
    return false
end

-- ---------- Highlight helper ----------
local function highlightModel(model)
    if not model:IsA("Model") then return end
    if model:FindFirstChild("PetFinderHighlight") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "PetFinderHighlight"
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.OutlineColor = Color3.fromRGB(0, 255, 0)
    hl.Parent = model
end

-- ---------- Scanning ----------
local function scanWorkspaceForTargets()
    local results, lowerTargets = {}, {}
    for _, t in ipairs(TargetPetNames) do table.insert(lowerTargets, t:lower()) end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local nameLower = obj.Name:lower()
            for _, target in ipairs(lowerTargets) do
                if string.find(nameLower, target) then
                    highlightModel(obj)
                    table.insert(results, {modelName = obj.Name})
                    break
                end
            end
        end
    end
    return results
end

-- ---------- Embed ----------
local function buildEmbedFromResults(results)
    local fields, count = {}, 0
    for _, entry in ipairs(results) do
        count += 1
        if count > MAX_FIELDS_PER_EMBED then break end
        table.insert(fields, {name = entry.modelName, value = "Encontrado ✅", inline = false})
    end

    local placeId, jobId = game.PlaceId, game.JobId
    local joinLink = string.format("https://www.roblox.com/games/%d?privateServerLinkCode=%s", placeId, jobId)
    local playersCount = string.format("👥 Players: %d/%d", #Players:GetPlayers(), Players.MaxPlayers)

    return {
        title = "🐾 Pets Encontrados",
        description = string.format("Scan feito por **%s**\n%s\n🔗 [Join Server](%s)", LocalPlayer.Name, playersCount, joinLink),
        color = 65280,
        fields = fields,
        footer = {text = "Pet Finder"},
        timestamp = DateTime.now():ToIsoDate()
    }
end

local function sendResultsToDiscord(results)
    if not results or #results == 0 then return false end
    local embed = buildEmbedFromResults(results)
    local payload = {username = "Pet Finder", embeds = {embed}}
    return sendWebhookPayload(HttpService:JSONEncode(payload))
end

