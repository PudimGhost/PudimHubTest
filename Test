    -- update list
    local function updateListGui(results)
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("Frame") and child.Name == "ResultItem" then child:Destroy() end
        end
        local n = math.min(#results, MAX_LIST_ITEMS)
        for i = 1, n do
            local r = results[i]
            local item = Instance.new("Frame", listFrame)
            item.Name = "ResultItem"
            item.Size = UDim2.new(1, -12, 0, 40)
            item.BackgroundColor3 = Color3.fromRGB(18,18,18)
            item.BorderSizePixel = 0
            Instance.new("UICorner", item).CornerRadius = UDim.new(0,6)
            item.LayoutOrder = i

            local title = Instance.new("TextLabel", item)
            title.Size = UDim2.new(1, -12, 0, 20)
            title.Position = UDim2.new(0, 6, 0, 10)
            title.BackgroundTransparency = 1
            title.Font = Enum.Font.GothamBold
            title.TextSize = 14
            title.TextColor3 = Color3.fromRGB(0,255,0)
            title.Text = (r.modelName or "Unknown")
        end
        listFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(0, uiListLayout.AbsoluteContentSize.Y + 8))
    end

    local function doScanAndUpdateGui()
        statusLabel.Text = "Status: Scanning..."
        local ok, results = pcall(scanWorkspaceForTargets)
        if not ok then
            statusLabel.Text = "Status: Error scanning"
            return
        end
        LastScanResults = results
        statusLabel.Text = "Status: Idle | Found: "..tostring(#results)
        updateListGui(results)
    end

    btnScan.MouseButton1Click:Connect(function() doScanAndUpdateGui() end)
    btnAuto.MouseButton1Click:Connect(function()
        if AutoScan then
            AutoScan = false
            btnAuto.Text = "Auto: OFF"
            btnAuto.BackgroundColor3 = Color3.fromRGB(120,60,60)
        else
            AutoScan = true
            btnAuto.Text = "Auto: ON"
            btnAuto.BackgroundColor3 = Color3.fromRGB(60,160,60)
            task.spawn(function()
                while AutoScan do
                    doScanAndUpdateGui()
                    task.wait(tonumber(ScanInterval) or DEFAULT_SCAN_INTERVAL)
                end
            end)
        end
    end)
    btnSend.MouseButton1Click:Connect(function() sendResultsToDiscord(LastScanResults) end)

    intervalBox.FocusLost:Connect(function()
        local v = tonumber(intervalBox.Text)
        if v and v >= 1 then ScanInterval = v end
        intervalBox.Text = tostring(ScanInterval)
    end)
end

